# Copy to .env for `docker compose up`. .env is git-ignored; this file is not.
#
#   cp .env.example .env
#
# Nothing here is secret except DLLM_GATEWAY_KEYS, and that holds only hashes.

# --- Gateway auth -----------------------------------------------------------
# JSON ARRAY of key records. Mint with:
#
#   dllm serve keys --count 1
#
# That prints the plaintext key ONCE plus its hash. Keep the plaintext for
# clients; put everything except the "key" field here.
#
# It must be an array even for a single key. A bare object is the most common
# mistake -- some shells and serialisers unwrap a one-element array -- and the
# gateway refuses to start rather than guess.
#
# Leave it unset and the gateway returns 503 to everything. It never runs open.
DLLM_GATEWAY_KEYS=[{"key_id":"REPLACE","key_hash":"REPLACE","tier":"default"}]

# Port the gateway is published on. vLLM is deliberately NOT published: it has
# no authentication, so exposing it hands over the GPU.
GATEWAY_PORT=8080

# --- Serving profile ----------------------------------------------------------
# GPU (default): leave these two commented out.
# CPU, no NVIDIA GPU needed: uncomment both. Same gateway, same API, vLLM's CPU
# backend instead of CUDA. See docker-compose.cpu.yml and configs/serve_cpu.yaml.
# The separator is set explicitly because Compose expects ";" on Windows.
#
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml

# Merged model directory mounted into vLLM. Defaults to the output of
# `make merge`.
# MERGED_MODEL_DIR=./artifacts/merged/current

# --- vLLM -------------------------------------------------------------------
SERVED_MODEL_NAME=domain-sql
DTYPE=bfloat16

# Fractions of total VRAM vLLM may claim, and the KV-cache sizing that follows.
# Defaults suit a 24 GB card. On 8 GB with a 1.5B model (~3.1 GB of weights)
# these are the settings that leave room for the desktop compositor:
#
#   GPU_MEMORY_UTILIZATION=0.80
#   MAX_NUM_SEQS=32
#   MAX_MODEL_LEN=2048
#
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=64
MAX_MODEL_LEN=2048

# --- Client -----------------------------------------------------------------
# The plaintext key, used by `dllm bench run` and the eval harness when pointed
# at a served endpoint. Not read by the gateway itself.
DLLM_API_KEY=
