# Environment / secrets
.env
.env.*
!.env.example
*.key
gateway_keys.json

# Model + data artefacts (large, reproducible from scripts)
#
# data/processed/ matters more than it looks: those splits derive from Spider
# (CC-BY-SA-4.0), and this repo deliberately ships the preparation script rather
# than the data so it does not redistribute a share-alike derivative. Do not
# un-ignore it.
artifacts/
data/raw/
data/interim/
data/processed/
# Generated by `dllm data audit` on every run. The committed, human-readable
# version is docs/LICENCE_AUDIT.md; this is the machine-readable twin and
# carries a timestamp, so tracking it would churn the diff.
data/licence_audit.json
checkpoints/
outputs/
merged/
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# MLflow local backing store
mlruns/
mlartifacts/
mlflow.db

# Eval + bench working dirs (committed results live in evals/results/ and docs/)
.eval_cache/
bench_raw/

# HF cache when pointed inside the repo
.hf_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
